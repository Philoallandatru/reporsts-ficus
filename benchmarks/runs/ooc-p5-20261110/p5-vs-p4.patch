+void llama_moe_cache::log_file_stats() const {
+    if (!pimpl->expert_session) {
+        return;
+    }
+    pimpl->log_stats();
+    pimpl->expert_session->log_stats();
+    size_t routed = 0, routed_bytes = 0, gpu = 0, gpu_bytes = 0, shared = 0, shared_bytes = 0;
+    for (const auto & g : pimpl->groups) {
+        size_t bytes = 0;
+        for (const auto * t : g.ref) {
+            bytes += t->nb[2];
+        }
+        for (const auto last : g.lru.last_use) {
+            if (last >= 0) {
+                ++routed;
+                routed_bytes += bytes;
+            }
+        }
+        gpu += g.lru.n_filled;
+        gpu_bytes += g.lru.n_filled*bytes;
+    }
+    pimpl->expert_session->visit_resident([&](const ggml_tensor * t, size_t expert, size_t bytes) {
+        const auto found = pimpl->bindings.find(t);
+        if (found == pimpl->bindings.end()) {
+            return;
+        }
+        const int32_t il = found->second.il;
+        const auto & g = pimpl->groups[pimpl->layers[il].ig];
+        if (g.lru.slot_map[il][expert] < g.lru.n_slots) {
+            ++shared;
+            shared_bytes += bytes;
+        }
+    });
+    LLAMA_LOG_INFO("llama_file_residency: routed decode experts = %zu, routed bytes = %zu, GPU experts = %zu, GPU bytes = %zu, shared role entries = %zu, shared bytes = %zu, general calls = %llu\n",
+        routed, routed_bytes, gpu, gpu_bytes, shared, shared_bytes, (unsigned long long) pimpl->file_general_calls);
+}
