+void llama_context::file_expert_graph_assign(ggml_cgraph * graph) {
+    const auto * store = model.expert_store();
+    if (!store || !graph) {
+        return;
+    }
+    for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+        auto * node = ggml_graph_node(graph, i);
+        if (node->op != GGML_OP_MUL_MAT_ID || !store->contains(node->src[0])) {
+            continue;
+        }
+        // Small batches can exceed cache capacity but fall below the normal GPU offload threshold.
+        for (auto * backend : backend_ptrs) {
+            if (ggml_backend_dev_type(ggml_backend_get_device(backend)) == GGML_BACKEND_DEVICE_TYPE_GPU &&
+                ggml_backend_supports_op(backend, node)) {
+                ggml_backend_sched_set_tensor_backend(sched.get(), node, backend);
+                break;
+            }
+        }
+    }
 }
 
