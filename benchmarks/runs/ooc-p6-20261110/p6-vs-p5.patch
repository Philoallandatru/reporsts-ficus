+        ggml_new_tensor_3d(ctx.get(), GGML_TYPE_I8, 4096, 1, 64),
+        ggml_new_tensor_3d(ctx.get(), GGML_TYPE_I8, 65536, 1, 16),
+        ggml_new_tensor_3d(ctx.get(), GGML_TYPE_I8, 1048576, 1, 2),
+    };
