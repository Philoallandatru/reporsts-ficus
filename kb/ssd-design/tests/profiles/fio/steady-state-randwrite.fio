[global]
filename=/dev/nvmeXnY
direct=1
ioengine=libaio
time_based=1
runtime=1800
ramp_time=300
group_reporting=1
write_lat_log=steady-randwrite
log_avg_msec=1000

[precondition]
stonewall
rw=write
bs=128k
iodepth=32
numjobs=1
size=100%

[steady_randwrite]
rw=randwrite
bs=4k
iodepth=64
numjobs=4
size=100%
