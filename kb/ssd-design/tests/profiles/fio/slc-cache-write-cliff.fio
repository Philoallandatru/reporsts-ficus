[global]
filename=/dev/nvmeXnY
direct=1
ioengine=libaio
time_based=0
group_reporting=1
write_lat_log=slc-cache-write-cliff
log_avg_msec=1000

[burst_fill_slc]
rw=write
bs=128k
iodepth=32
numjobs=1
size=20%
stonewall

[small_random_until_cliff]
rw=randwrite
bs=4k
iodepth=64
numjobs=4
size=100%
runtime=3600
time_based=1
stonewall

[mixed_read_during_destage]
rw=randrw
rwmixread=80
bs=4k
iodepth=32
numjobs=4
size=100%
runtime=1800
time_based=1
