[global]
filename=/dev/nvmeXnY
direct=1
ioengine=libaio
time_based=1
group_reporting=1
read_lat_log=hmb-mapping-miss-storm
write_lat_log=hmb-mapping-miss-storm
log_avg_msec=1000

[wide_random_read]
rw=randread
bs=4k
iodepth=128
numjobs=8
size=100%
runtime=1800
stonewall

[wide_random_mixed]
rw=randrw
rwmixread=70
bs=4k
iodepth=128
numjobs=8
size=100%
runtime=1800
stonewall

[gc_pressure_write]
rw=randwrite
bs=4k
iodepth=64
numjobs=4
size=100%
runtime=1800
